# GEMINI_API_KEY: Required for Gemini AI API calls (ASAD AI Portfolio Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Destination email address to receive new website lead notifications.
# Example: aliofficialtech1@gmail.com
ADMIN_EMAIL=""

# ADMIN_PASSWORD: Secret password to access the private admin lead dashboard at /admin.
# Set a strong password in production.
ADMIN_PASSWORD="asad_admin_2026"

# RESEND_API_KEY: Transactional email API key from resend.com.
# Required to send automatic admin lead notifications and customer confirmation emails.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Verified sender email address in Resend (e.g. "Asad Ali Awan <noreply@yourdomain.com>").
# Defaults to Resend's onboarding address for testing if omitted.
RESEND_FROM_EMAIL=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: (Optional)
# Provide your Supabase Project URL and Service Role Key to persist leads in PostgreSQL.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_WHATSAPP_NUMBER: Configurable WhatsApp number (digits with country code).
VITE_WHATSAPP_NUMBER="923164227321"
